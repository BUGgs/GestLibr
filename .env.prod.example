COMPOSE_PROJECT_NAME=gestlibr-prod
TZ=Europe/Paris
DEPLOY_BASE_DIR=/srv/gestlibr
PROXY_NETWORK=proxy

WEB_PORT=80
PHPMYADMIN_BIND_ADDRESS=127.0.0.1
PHPMYADMIN_PORT=8081

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=gestlibr
MYSQL_USER=gestlibr
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_PLATFORM=linux/arm64/v8

MYSQL_INIT_FILE=./docker/mysql/init/01-gestlibr.sql
MYSQL_DATA_DIR=./docker/mysql/data

EBAY_PROVIDER=legacy
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://votre-domaine/index.php?m=in&a=eb&oauth_callback=1
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_FIXED_CATEGORY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_PAYMENT_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_REFRESH_TOKEN=
GOOGLE_BOOKS_API_KEY=
EBAY_SYNC_TRIGGER_TOKEN=
BOOK_AUTOSAVE_ENABLED=0

AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_VERSION=2.2
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_CREATORS_MARKETPLACE=www.amazon.fr
AMAZON_CREATORS_LANGUAGE=fr_FR
AMAZON_CREATORS_BASE_URL=https://creatorsapi.amazon
# Optional override (auto-derived from version if empty)
AMAZON_CREATORS_TOKEN_ENDPOINT=
AMAZON_CREATORS_SCOPE=
